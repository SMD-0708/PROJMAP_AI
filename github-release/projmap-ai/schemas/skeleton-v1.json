{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://projmap.dev/schemas/skeleton-v1.json",
  "title": "ProjMap Skeleton Schema",
  "description": "骨架提取JSON Schema定义 - 确保程序扫描100%完整性",
  "type": "object",
  "required": ["project_root", "scan_time", "files"],
  "properties": {
    "project_root": {
      "type": "string",
      "description": "项目根目录绝对路径"
    },
    "scan_time": {
      "type": "string",
      "format": "date-time",
      "description": "扫描时间（ISO 8601格式）"
    },
    "total_files": {
      "type": "integer",
      "minimum": 0,
      "description": "扫描文件总数"
    },
    "total_directories": {
      "type": "integer",
      "minimum": 0,
      "description": "目录总数"
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/FileSkeleton"
      },
      "description": "所有文件的骨架信息"
    },
    "summary": {
      "$ref": "#/definitions/ProjectSummary",
      "description": "项目摘要统计"
    }
  },
  "definitions": {
    "FileSkeleton": {
      "type": "object",
      "required": ["path", "file_name", "file_size", "file_type"],
      "properties": {
        "path": {
          "type": "string",
          "description": "文件相对路径"
        },
        "file_name": {
          "type": "string",
          "description": "文件名"
        },
        "file_size": {
          "type": "integer",
          "minimum": 0,
          "description": "文件大小（字节）"
        },
        "file_type": {
          "type": "string",
          "enum": ["python", "jupyter", "csv", "markdown", "json", "yaml", "unknown"],
          "description": "文件类型"
        },
        "line_count": {
          "type": "integer",
          "minimum": 0,
          "description": "行数"
        },
        "python": {
          "$ref": "#/definitions/PythonSkeleton"
        },
        "jupyter": {
          "$ref": "#/definitions/JupyterSkeleton"
        },
        "csv": {
          "$ref": "#/definitions/CSVSkeleton"
        },
        "markdown": {
          "$ref": "#/definitions/MarkdownSkeleton"
        },
        "json": {
          "$ref": "#/definitions/JSONSkeleton"
        }
      }
    },
    "PythonSkeleton": {
      "type": "object",
      "description": "Python文件骨架信息",
      "properties": {
        "imports": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ImportInfo"
          },
          "description": "导入信息"
        },
        "exports": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "导出的符号（__all__）"
        },
        "functions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FunctionInfo"
          },
          "description": "函数定义"
        },
        "classes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ClassInfo"
          },
          "description": "类定义"
        },
        "module_variables": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "模块级变量"
        },
        "file_reads": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FileOperation"
          },
          "description": "文件读取操作"
        },
        "file_writes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FileOperation"
          },
          "description": "文件写入操作"
        },
        "top_level_docstring": {
          "type": ["string", "null"],
          "description": "模块级文档字符串"
        },
        "todos": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TodoItem"
          },
          "description": "TODO/FIXME注释"
        },
        "call_graph": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": "函数调用图"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "外部依赖包名"
        }
      }
    },
    "ImportInfo": {
      "type": "object",
      "required": ["module"],
      "properties": {
        "module": {
          "type": "string",
          "description": "导入的模块名"
        },
        "names": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "from导入的具体名称"
        },
        "alias": {
          "type": ["string", "null"],
          "description": "别名"
        },
        "is_from_import": {
          "type": "boolean",
          "description": "是否为from...import形式"
        },
        "line_number": {
          "type": "integer",
          "minimum": 1,
          "description": "所在行号"
        }
      }
    },
    "FunctionInfo": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "description": "函数名"
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ParameterInfo"
          },
          "description": "参数列表"
        },
        "return_type": {
          "type": ["string", "null"],
          "description": "返回类型注解"
        },
        "docstring": {
          "type": ["string", "null"],
          "description": "文档字符串"
        },
        "line_start": {
          "type": "integer",
          "minimum": 1,
          "description": "起始行号"
        },
        "line_end": {
          "type": "integer",
          "minimum": 1,
          "description": "结束行号"
        },
        "decorators": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "装饰器列表"
        },
        "is_async": {
          "type": "boolean",
          "description": "是否为异步函数"
        }
      }
    },
    "ParameterInfo": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "description": "参数名"
        },
        "type": {
          "type": ["string", "null"],
          "description": "类型注解"
        },
        "default": {
          "type": ["string", "null"],
          "description": "默认值"
        },
        "kind": {
          "type": "string",
          "enum": ["positional", "keyword", "varargs", "kwargs"],
          "description": "参数类型"
        }
      }
    },
    "ClassInfo": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "description": "类名"
        },
        "bases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "基类列表"
        },
        "methods": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FunctionInfo"
          },
          "description": "方法列表"
        },
        "docstring": {
          "type": ["string", "null"],
          "description": "文档字符串"
        },
        "line_start": {
          "type": "integer",
          "minimum": 1
        },
        "line_end": {
          "type": "integer",
          "minimum": 1
        },
        "decorators": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "class_variables": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "类变量"
        }
      }
    },
    "FileOperation": {
      "type": "object",
      "required": ["target", "method"],
      "properties": {
        "target": {
          "type": "string",
          "description": "目标文件路径（可能是模式匹配）"
        },
        "method": {
          "type": "string",
          "description": "操作方法（open, read_csv, to_csv等）"
        },
        "line_number": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "TodoItem": {
      "type": "object",
      "required": ["type", "content"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["TODO", "FIXME", "HACK", "XXX", "NOTE"],
          "description": "注释类型"
        },
        "content": {
          "type": "string",
          "description": "注释内容"
        },
        "line_number": {
          "type": "integer",
          "minimum": 1
        },
        "priority": {
          "type": ["string", "null"],
          "enum": ["high", "medium", "low", null]
        }
      }
    },
    "JupyterSkeleton": {
      "type": "object",
      "description": "Jupyter Notebook骨架信息",
      "properties": {
        "cell_count": {
          "type": "integer",
          "minimum": 0
        },
        "code_cells": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CodeCell"
          }
        },
        "markdown_cells": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/MarkdownCell"
          }
        },
        "imports": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ImportInfo"
          }
        },
        "functions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FunctionInfo"
          }
        },
        "classes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ClassInfo"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CellOutput"
          }
        }
      }
    },
    "CodeCell": {
      "type": "object",
      "properties": {
        "cell_index": {
          "type": "integer"
        },
        "execution_count": {
          "type": ["integer", "null"]
        },
        "source_lines": {
          "type": "integer"
        },
        "has_output": {
          "type": "boolean"
        }
      }
    },
    "MarkdownCell": {
      "type": "object",
      "properties": {
        "cell_index": {
          "type": "integer"
        },
        "headings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "CellOutput": {
      "type": "object",
      "properties": {
        "cell_index": {
          "type": "integer"
        },
        "output_type": {
          "type": "string"
        },
        "has_data": {
          "type": "boolean"
        }
      }
    },
    "CSVSkeleton": {
      "type": "object",
      "description": "CSV数据文件骨架信息",
      "properties": {
        "column_names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "row_count": {
          "type": "integer",
          "minimum": 0
        },
        "column_count": {
          "type": "integer",
          "minimum": 0
        },
        "sample_rows": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "前几行样本数据"
        },
        "dtypes_guess": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "列类型推断"
        },
        "has_header": {
          "type": "boolean"
        },
        "delimiter": {
          "type": "string"
        },
        "null_count": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        }
      }
    },
    "MarkdownSkeleton": {
      "type": "object",
      "description": "Markdown文档骨架信息",
      "properties": {
        "headings": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Heading"
          }
        },
        "code_blocks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CodeBlock"
          }
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Link"
          }
        },
        "images": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Image"
          }
        },
        "todos": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TodoItem"
          }
        },
        "word_count": {
          "type": "integer",
          "minimum": 0
        },
        "reading_time_minutes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "Heading": {
      "type": "object",
      "properties": {
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "text": {
          "type": "string"
        },
        "line_number": {
          "type": "integer"
        }
      }
    },
    "CodeBlock": {
      "type": "object",
      "properties": {
        "language": {
          "type": ["string", "null"]
        },
        "line_start": {
          "type": "integer"
        },
        "line_end": {
          "type": "integer"
        }
      }
    },
    "Link": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "is_internal": {
          "type": "boolean"
        }
      }
    },
    "Image": {
      "type": "object",
      "properties": {
        "alt_text": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      }
    },
    "JSONSkeleton": {
      "type": "object",
      "description": "JSON配置文件骨架信息",
      "properties": {
        "top_level_keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "structure_depth": {
          "type": "integer",
          "minimum": 0
        },
        "array_lengths": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "value_types": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "sample_values": {
          "type": "object"
        }
      }
    },
    "ProjectSummary": {
      "type": "object",
      "properties": {
        "total_lines": {
          "type": "integer"
        },
        "total_functions": {
          "type": "integer"
        },
        "total_classes": {
          "type": "integer"
        },
        "total_imports": {
          "type": "integer"
        },
        "unique_dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "file_type_distribution": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "largest_files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {"type": "string"},
              "size": {"type": "integer"}
            }
          }
        }
      }
    }
  }
}
