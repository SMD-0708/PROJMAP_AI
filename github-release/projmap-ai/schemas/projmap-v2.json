{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://projmap.dev/schemas/projmap-v2.json",
  "title": "ProjMap File Format",
  "description": "ProjMap 项目认知脉络文件标准 v2.0 - 增强版（技术标签、决策追溯、废线管理）",
  "type": "object",
  "required": ["version", "metadata", "nodes", "edges"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": ".projmap 文件格式版本",
      "default": "2.0"
    },
    "metadata": {
      "type": "object",
      "required": ["project_name", "project_root", "created_at"],
      "properties": {
        "project_name": {
          "type": "string",
          "description": "项目名称"
        },
        "project_root": {
          "type": "string",
          "description": "项目根路径（绝对路径）"
        },
        "description": {
          "type": "string",
          "description": "项目描述"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "创建时间（ISO 8601格式）"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "最后更新时间（ISO 8601格式）"
        },
        "generator": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "生成器名称",
              "default": "projmap-cli"
            },
            "version": {
              "type": "string",
              "description": "生成器版本"
            }
          }
        },
        "trust_level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "信任梯度档位：1=纯本地, 2=骨架, 3=注释, 4=参数, 5=全量",
          "default": 1
        },
        "llm_model": {
          "type": "string",
          "description": "使用的LLM模型（如 qwen-turbo），纯本地模式为null"
        },
        "domain": {
          "type": "string",
          "enum": ["general", "research", "fintech", "software"],
          "description": "项目领域",
          "default": "general"
        }
      }
    },
    "nodes": {
      "type": "array",
      "description": "项目节点列表",
      "items": {
        "$ref": "#/definitions/Node"
      }
    },
    "edges": {
      "type": "array",
      "description": "节点间关系边列表",
      "items": {
        "$ref": "#/definitions/Edge"
      }
    },
    "decisions": {
      "type": "array",
      "description": "决策点记录列表",
      "items": {
        "$ref": "#/definitions/Decision"
      }
    },
    "active_state": {
      "type": "object",
      "description": "活跃状态追踪",
      "properties": {
        "active_main": {
          "type": "string",
          "description": "当前主线节点ID"
        },
        "active_branches": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "活跃分支节点ID列表"
        }
      }
    }
  },
  "definitions": {
    "NodeStatus": {
      "type": "string",
      "enum": ["active_main", "active_branch", "dormant", "archived"],
      "description": "节点状态：active_main=主线, active_branch=实验分支, dormant=休眠, archived=归档"
    },
    "NodeType": {
      "type": "string",
      "enum": ["file", "module", "package", "directory"],
      "description": "节点类型"
    },
    "ExecutionStatus": {
      "type": "string",
      "enum": ["unknown", "success", "failure", "running", "blocked", "pending"],
      "description": "执行状态：unknown=未知, success=成功, failure=失败, running=运行中, blocked=阻塞, pending=待执行"
    },
    "InferenceSource": {
      "type": "string",
      "enum": ["unknown", "llm", "rule", "git", "manual"],
      "description": "推断来源：unknown=未知, llm=AI推断, rule=规则推断, git=Git历史, manual=手动"
    },
    "TechTag": {
      "type": "object",
      "required": ["name", "category", "domain"],
      "properties": {
        "name": {
          "type": "string",
          "description": "标签名称（如：PCA、XGBoost、LSTM）"
        },
        "category": {
          "type": "string",
          "description": "标签类别（如：特征工程、模型算法）"
        },
        "domain": {
          "type": "string",
          "enum": ["fintech", "research", "software", "custom"],
          "description": "标签领域"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "匹配置信度",
          "default": 1.0
        },
        "decision_id": {
          "type": "string",
          "description": "关联的决策记录ID"
        },
        "source": {
          "type": "string",
          "enum": ["auto", "manual"],
          "description": "标签来源：auto=自动识别, manual=手动添加",
          "default": "auto"
        },
        "line_number": {
          "type": "integer",
          "description": "匹配的代码行号"
        }
      }
    },
    "Artifact": {
      "type": "object",
      "required": ["name", "file_path", "artifact_type"],
      "properties": {
        "name": {
          "type": "string",
          "description": "产出物名称"
        },
        "file_path": {
          "type": "string",
          "description": "产出物文件路径"
        },
        "artifact_type": {
          "type": "string",
          "description": "产出物类型（model, data, config, log, image, report）"
        },
        "size": {
          "type": "integer",
          "description": "文件大小（字节）"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "description": {
          "type": "string",
          "description": "产出物描述"
        }
      }
    },
    "FailureInfo": {
      "type": "object",
      "required": ["error_type", "error_message", "occurred_at"],
      "properties": {
        "error_type": {
          "type": "string",
          "description": "错误类型"
        },
        "error_message": {
          "type": "string",
          "description": "错误信息"
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time",
          "description": "发生时间"
        },
        "stack_trace": {
          "type": "string",
          "description": "堆栈跟踪"
        },
        "attempted_solutions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "尝试过的解决方案"
        },
        "resolved": {
          "type": "boolean",
          "description": "是否已解决",
          "default": false
        },
        "resolution": {
          "type": "string",
          "description": "解决方案描述"
        }
      }
    },
    "TodoItem": {
      "type": "object",
      "required": ["id", "description", "status"],
      "properties": {
        "id": {
          "type": "string",
          "description": "待办项ID"
        },
        "description": {
          "type": "string",
          "description": "待办描述"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "in_progress", "completed"],
          "description": "待办状态"
        },
        "priority": {
          "type": "string",
          "enum": ["high", "medium", "low"],
          "description": "优先级",
          "default": "medium"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "AbandonInfo": {
      "type": "object",
      "required": ["abandoned_method", "abandon_reason"],
      "properties": {
        "abandoned_method": {
          "type": "string",
          "description": "废弃的方法名称"
        },
        "abandon_reason": {
          "type": "string",
          "description": "废弃原因"
        },
        "attempted_solutions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "尝试过的解决方案"
        },
        "can_revive": {
          "type": "boolean",
          "description": "是否可以唤醒",
          "default": true
        },
        "revive_condition": {
          "type": "string",
          "description": "唤醒条件"
        },
        "abandoned_by": {
          "type": "string",
          "description": "废弃操作人"
        },
        "abandoned_at": {
          "type": "string",
          "format": "date-time",
          "description": "废弃时间"
        }
      }
    },
    "Node": {
      "type": "object",
      "required": ["id", "name", "file_path", "status"],
      "properties": {
        "id": {
          "type": "string",
          "description": "节点唯一标识（建议使用文件路径的hash）"
        },
        "name": {
          "type": "string",
          "description": "任务名（LLM推断或用户自定义）"
        },
        "file_path": {
          "type": "string",
          "description": "文件相对路径（相对于项目根目录）"
        },
        "file_name": {
          "type": "string",
          "description": "文件名（用于显示）"
        },
        "type": {
          "$ref": "#/definitions/NodeType",
          "default": "file"
        },
        "status": {
          "$ref": "#/definitions/NodeStatus"
        },
        "function_tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "功能标签列表（LLM推断），如：['数据处理', '模型训练', '可视化']"
        },
        "description": {
          "type": "string",
          "description": "节点描述"
        },
        "is_entry": {
          "type": "boolean",
          "description": "是否为入口文件",
          "default": false
        },
        "language": {
          "type": "string",
          "description": "编程语言，如 python, javascript"
        },
        "children": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "关联子文件/模块ID列表"
        },
        "exports": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "导出的函数/类名列表"
        },
        "imports": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "导入的模块列表"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "execution_status": {
          "$ref": "#/definitions/ExecutionStatus",
          "default": "unknown"
        },
        "input_sources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "输入数据源列表"
        },
        "output_targets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "输出目标列表"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Artifact"
          },
          "description": "产出物列表"
        },
        "failure_info": {
          "$ref": "#/definitions/FailureInfo",
          "description": "失败信息（仅当执行状态为failure时）"
        },
        "next_steps": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "下一步行动建议"
        },
        "todos": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TodoItem"
          },
          "description": "待办事项列表"
        },
        "tech_tags": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TechTag"
          },
          "description": "技术标签列表"
        },
        "inferred_by": {
          "$ref": "#/definitions/InferenceSource",
          "default": "unknown"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "推断置信度",
          "default": 0
        },
        "needs_confirmation": {
          "type": "boolean",
          "description": "是否需要用户确认",
          "default": false
        },
        "abandon_info": {
          "$ref": "#/definitions/AbandonInfo",
          "description": "废弃信息（仅当状态为dormant时）"
        },
        "main_file": {
          "type": "boolean",
          "description": "是否为主文件",
          "default": true
        },
        "status_changed_at": {
          "type": "string",
          "format": "date-time",
          "description": "状态变更时间"
        },
        "status_changed_reason": {
          "type": "string",
          "description": "状态变更原因"
        }
      }
    },
    "EdgeType": {
      "type": "string",
      "enum": ["imports", "calls", "reads", "writes", "depends_on", "contains", "data_flow", "control_flow"],
      "description": "边类型：imports=导入, calls=调用, reads=读取, writes=写入, depends_on=依赖, contains=包含, data_flow=数据流, control_flow=控制流"
    },
    "FlowType": {
      "type": "string",
      "enum": ["data", "control", "dependency", "unknown"],
      "description": "流向类型：data=数据流, control=控制流, dependency=依赖, unknown=未知"
    },
    "Edge": {
      "type": "object",
      "required": ["id", "source", "target", "type"],
      "properties": {
        "id": {
          "type": "string",
          "description": "边唯一标识"
        },
        "source": {
          "type": "string",
          "description": "源节点ID"
        },
        "target": {
          "type": "string",
          "description": "目标节点ID"
        },
        "type": {
          "$ref": "#/definitions/EdgeType"
        },
        "description": {
          "type": "string",
          "description": "流向说明"
        },
        "decision_id": {
          "type": "string",
          "description": "关联的决策点ID"
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "边权重（用于可视化布局）",
          "default": 1
        },
        "flow_type": {
          "$ref": "#/definitions/FlowType",
          "description": "流向类型"
        },
        "flow_label": {
          "type": "string",
          "description": "流向标签（如：输入、输出、参数传递）"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "boolean", "array", "object"]
          },
          "description": "传递的参数"
        },
        "edge_status": {
          "type": "string",
          "enum": ["active", "abandoned", "deprecated"],
          "description": "边状态",
          "default": "active"
        }
      }
    },
    "DecisionType": {
      "type": "string",
      "enum": ["parameter", "architecture", "algorithm", "abandoned", "milestone", "failure", "method_selection", "parameter_determination", "architecture_tradeoff", "path_abandonment"],
      "description": "决策类型"
    },
    "DecisionSource": {
      "type": "string",
      "enum": ["unknown", "code_comment", "git_commit", "llm_analysis", "manual", "code_annotation"],
      "description": "决策来源"
    },
    "Alternative": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "description": "备选方案名称"
        },
        "reason_rejected": {
          "type": "string",
          "description": "放弃原因"
        },
        "pros": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "优点"
        },
        "cons": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "缺点"
        }
      }
    },
    "FollowUp": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "description": "后续行动"
        },
        "due_date": {
          "type": "string",
          "format": "date-time",
          "description": "截止日期"
        },
        "condition": {
          "type": "string",
          "description": "触发条件"
        },
        "assigned_to": {
          "type": "string",
          "description": "负责人"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "in_progress", "completed", "cancelled"],
          "description": "跟进状态",
          "default": "pending"
        }
      }
    },
    "Decision": {
      "type": "object",
      "required": ["id", "node_id", "type", "content", "timestamp"],
      "properties": {
        "id": {
          "type": "string",
          "description": "决策点唯一标识"
        },
        "node_id": {
          "type": "string",
          "description": "关联节点ID"
        },
        "type": {
          "$ref": "#/definitions/DecisionType"
        },
        "content": {
          "type": "string",
          "description": "决策内容描述"
        },
        "reason": {
          "type": "string",
          "description": "决策原因/理由"
        },
        "alternatives": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Alternative"
          },
          "description": "备选方案列表"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "boolean", "array", "object"]
          },
          "description": "参数记录（键值对）"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "决策时间"
        },
        "source": {
          "$ref": "#/definitions/DecisionSource",
          "default": "unknown"
        },
        "file_path": {
          "type": "string",
          "description": "关联文件路径"
        },
        "line_number": {
          "type": "integer",
          "description": "代码行号"
        },
        "decision_basis": {
          "type": "string",
          "description": "决策依据（实验数据、参考文献、经验判断）"
        },
        "decision_result": {
          "type": "string",
          "description": "决策结果"
        },
        "tech_tag": {
          "type": "string",
          "description": "关联的技术标签"
        },
        "follow_up": {
          "$ref": "#/definitions/FollowUp",
          "description": "后续跟进"
        },
        "impact": {
          "type": "string",
          "enum": ["high", "medium", "low"],
          "description": "影响程度"
        },
        "reversible": {
          "type": "boolean",
          "description": "是否可逆",
          "default": true
        }
      }
    }
  }
}
